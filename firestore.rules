rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNÇÕES AUXILIARES ---
    // Verifica se o usuário está autenticado.
    function isSignedIn() {
      return request.auth != null;
    }

    // Obtém os dados do perfil do usuário que está fazendo a requisição.
    function getUserData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.token.email.lower())).data;
    }

    // Verifica se o usuário é um Administrador aprovado.
    function isAdmin() {
      return isSignedIn() && getUserData().tipo_usuario == 'Administrador' && getUserData().status_aprovacao == 'aprovado';
    }

    // Verifica se o usuário é o dono do documento (baseado no UID).
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // --- COLEÇÕES ---

    // Coleção de Usuários
    // O ID do documento é o email normalizado (lowercase).
    match /usuarios/{email} {
      // Permite que um novo usuário crie seu próprio perfil (cadastro).
      // O `request.auth.token.email` garante que o usuário só pode criar um doc com seu próprio email.
      allow create: if isSignedIn() && request.auth.token.email.lower() == email;

      // Admins podem ler qualquer perfil. Clientes só podem ler o seu próprio.
      allow get: if isAdmin() || (isSignedIn() && request.auth.token.email.lower() == email);
      
      // Admins podem listar todos os usuários. Clientes não podem.
      allow list: if isAdmin();

      // Admins podem atualizar qualquer perfil (ex: aprovar, mudar tipo).
      // Clientes só podem atualizar seus próprios dados, e não podem mudar seu tipo ou status.
      allow update: if isAdmin() || 
                    (isSignedIn() && request.auth.token.email.lower() == email &&
                     request.resource.data.tipo_usuario == resource.data.tipo_usuario &&
                     request.resource.data.status_aprovacao == resource.data.status_aprovacao);

      // Apenas admins podem deletar usuários (ou uma Cloud Function para LGPD).
      allow delete: if isAdmin();

      // Subcoleções de perfil (anamnese, etc.)
      match /perfil/{docId} {
        // Regras similares: apenas o dono ou admin pode acessar.
        allow read, write: if isAdmin() || (isSignedIn() && request.auth.token.email.lower() == email);
      }
    }

    // Coleção de Agendamentos
    match /agendamentos/{agendamentoId} {
      // Clientes podem criar agendamentos para si mesmos. Admins podem criar para qualquer um.
      allow create: if isSignedIn();

      // Admins podem ler tudo. Clientes só podem ler seus próprios agendamentos.
      allow read: if isAdmin() || (isSignedIn() && resource.data.cliente_uid == request.auth.uid);

      // Admins podem atualizar qualquer agendamento. Clientes só podem atualizar os seus (ex: cancelar).
      allow update: if isAdmin() || (isSignedIn() && resource.data.cliente_uid == request.auth.uid);
      
      // Apenas admins podem deletar.
      allow delete: if isAdmin();
    }

    // Coleção de Configurações
    match /configuracoes/{configId} {
      // Todos os usuários autenticados podem ler as configurações.
      allow get: if isSignedIn();
      // Apenas administradores podem alterar as configurações.
      allow write: if isAdmin();
    }

    // Coleções de Logs (Auditoria e LGPD)
    match /{logCollection=**}/logs/{logId} {
      // Ninguém pode ler ou escrever logs diretamente do app cliente.
      // Isso deve ser feito por Cloud Functions para segurança máxima.
      // Se precisar que o admin leia, mude para `allow read: if isAdmin();`
      allow read, write: if false; 
    }
  }
}